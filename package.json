{
  "name": "civicdataforge-mcp-gateway",
  "version": "1.4.1",
  "private": false,
  "type": "module",
  "description": "Installable stdio MCP gateway for ten CivicDataForge government-record Actors.",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "civicdataforge-mcp": "server.mjs"
  },
  "files": [
    "server.mjs",
    "server.json",
    "glama.json",
    "schemas/",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test test/*.test.mjs",
    "test:package-boundary": "node --test test/package-boundary.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "apify-client": "2.22.1"
  }
}
